---
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="container-site py-16 sm:py-20">
  <div class="mx-auto max-w-3xl">
    <h2 class="font-sans text-2xl font-bold tracking-tight text-[var(--color-text)] sm:text-3xl">
      FaktumAI
    </h2>
    <p class="mt-4 max-w-2xl text-[var(--color-text-dim)]">
      {t(locale, 'aboutLead')}
    </p>
  </div>
</section>
