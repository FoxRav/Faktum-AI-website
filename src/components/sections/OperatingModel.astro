---
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="container-site py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-sans text-2xl font-bold tracking-tight text-[var(--color-text)] sm:text-3xl">
      {t(locale, 'operatingTitle')}
    </h2>
    <p class="mt-4 max-w-3xl text-[var(--color-text-dim)]">
      {t(locale, 'operatingIntro')}
    </p>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6">
        <span class="text-xs font-semibold uppercase tracking-wider text-cyan-400">
          {locale === 'fi' ? 'AI-agentit' : 'AI agents'}
        </span>
        <p class="mt-3 text-[var(--color-text-dim)]">{t(locale, 'operatingAgents')}</p>
      </div>
      <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6">
        <span class="text-xs font-semibold uppercase tracking-wider text-cyan-400">
          {locale === 'fi' ? 'Prosessit' : 'Processes'}
        </span>
        <p class="mt-3 text-[var(--color-text-dim)]">{t(locale, 'operatingProcesses')}</p>
      </div>
      <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6">
        <span class="text-xs font-semibold uppercase tracking-wider text-cyan-400">
          {locale === 'fi' ? 'Kevyt rakenne' : 'Lean structure'}
        </span>
        <p class="mt-3 text-[var(--color-text-dim)]">{t(locale, 'operatingLean')}</p>
      </div>
    </div>
  </div>
</section>
