---
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const cards = [
  { heading: t(locale, 'operatingCardProblemHeading'), body: t(locale, 'operatingCardProblemBody') },
  { heading: t(locale, 'operatingCardAiHeading'), body: t(locale, 'operatingCardAiBody') },
  { heading: t(locale, 'operatingCardTestHeading'), body: t(locale, 'operatingCardTestBody') },
];
---

<section class="container-site py-16 sm:py-20">
  <div class="mx-auto max-w-6xl">
    <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-400/80">
      {t(locale, 'operatingEyebrow')}
    </p>
    <h2 class="mt-3 font-sans text-2xl font-bold tracking-tight text-[var(--color-text)] sm:text-3xl">
      {t(locale, 'operatingHeading')}
    </h2>
    <p class="mt-4 max-w-3xl text-[var(--color-text-dim)]">
      {t(locale, 'operatingIntro')}
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((card) => (
        <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6">
          <h3 class="font-sans text-lg font-semibold tracking-tight text-[var(--color-text)]">
            {card.heading}
          </h3>
          <p class="mt-3 text-sm text-[var(--color-text-dim)]">
            {card.body}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
