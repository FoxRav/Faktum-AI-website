---
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';

interface Tab {
  href: string;
  label: string;
  filter?: string;
}

interface Props {
  tabs: Tab[];
  activeHref: string;
  locale?: Locale;
  filterable?: boolean;
  activeFilter?: string;
}

const { tabs, activeHref, locale = 'fi', filterable = false, activeFilter = 'all' } = Astro.props;
---

{filterable ? (
  <nav class="container-site border-b border-[var(--color-border)]" aria-label={t(locale, 'categoriesAriaLabel')}>
    <ul class="flex gap-1 overflow-x-auto pb-px [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="tablist">
      {tabs.map((tab) => {
        const filterValue = tab.filter ?? 'all';
        const isActive = filterValue === activeFilter;
        return (
          <li>
            <button
              type="button"
              role="tab"
              data-filter-tab={filterValue}
              aria-selected={isActive}
              class:list={[
                'cursor-pointer whitespace-nowrap border-b-2 px-4 py-3 text-sm font-medium transition',
                isActive
                  ? 'border-cyan-400 text-cyan-300'
                  : 'border-transparent text-[var(--color-text-dim)] hover:text-[var(--color-text)]',
              ]}
            >
              {tab.label}
            </button>
          </li>
        );
      })}
    </ul>
  </nav>
) : (
  <nav class="container-site border-b border-[var(--color-border)]" aria-label={t(locale, 'categoriesAriaLabel')}>
    <ul class="flex gap-1 overflow-x-auto pb-px [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {tabs.map((tab) => {
        const active = tab.href === activeHref;
        return (
          <li>
            <a
              href={tab.href}
              class:list={[
                'block whitespace-nowrap border-b-2 px-4 py-3 text-sm font-medium transition',
                active
                  ? 'border-cyan-400 text-cyan-300'
                  : 'border-transparent text-[var(--color-text-dim)] hover:text-[var(--color-text)]',
              ]}
            >
              {tab.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
)}

{filterable && (
  <script src="/js/feed-filter.js" type="module" is:inline />
)}
