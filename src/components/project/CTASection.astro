---
import type { ProjectCTA } from '../../data/projects';

interface Props {
  cta: ProjectCTA;
  locale: 'fi' | 'en';
}

const { cta, locale } = Astro.props;
const isEn = locale === 'en';
const variant = cta.variant ?? 'primary';
---

<section class="mb-12">
  <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6 sm:p-8">
    <h2 class="font-sans text-2xl font-bold tracking-tight text-[var(--color-text)]">
      {cta.heading}
    </h2>
    {cta.text && (
      <p class="mt-3 max-w-2xl text-[var(--color-text-dim)]">
        {cta.text}
      </p>
    )}
    {cta.contactText && (
      <p class="mt-2 text-sm text-[var(--color-text-dim)]">
        {cta.contactText}
      </p>
    )}
    {cta.label && (
      <div class="mt-6">
        {variant === 'secondary' ? (
          <a
            href={cta.href}
            class="inline-block rounded-lg border border-[var(--color-border)] px-5 py-2.5 text-sm font-medium text-[var(--color-text-dim)] transition hover:border-cyan-500/40 hover:text-[var(--color-text)]"
          >
            {cta.label}
          </a>
        ) : (
          <a
            href={cta.href}
            class="inline-block rounded-lg bg-cyan-500 px-5 py-2.5 text-sm font-semibold text-[var(--color-bg)] transition hover:bg-cyan-400"
          >
            {cta.label}
          </a>
        )}
      </div>
    )}
  </div>
</section>
