---
import type { Locale } from '../../i18n/config';
import type { Project, ProjectDetail } from '../../data/projects';
import { projectLocale } from '../../data/projects';
import { categoryPath } from '../../i18n/paths';
import ProjectSection from './ProjectSection.astro';
import ProductionReference from './ProductionReference.astro';
import Callout from './Callout.astro';
import Disclaimer from './Disclaimer.astro';
import CTASection from './CTASection.astro';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const p = projectLocale(project, locale);
const detail: ProjectDetail = p.detail;
const projectsHref = categoryPath(locale, 'projects');
const isEn = locale === 'en';

function toHtml(value: string): string {
  return value.replace(/\n\n/g, '</p><p>');
}

const whatItIsHtml = toHtml(detail.whatItIs);
const problemHtml = toHtml(detail.problem);
const solutionHtml = toHtml(detail.solution);
const technicalHtml = toHtml(detail.technical);
const currentStateHtml = toHtml(detail.currentState);
const nextStepHtml = toHtml(detail.nextStep);
const aiRoleHtml = detail.aiRole ? toHtml(detail.aiRole) : '';
const orgBodyHtml = detail.organisationDeployment
  ? detail.organisationDeployment.body.replace(/\n\n/g, '</p><p>')
  : '';
---

<article class="w-full">
  <header class="mx-auto max-w-5xl">
    <nav aria-label="Breadcrumbs" class="mb-6 text-sm">
      <a href={projectsHref} class="text-cyan-400 hover:text-cyan-300">
        {isEn ? '← Projects' : '← Projektit'}
      </a>
    </nav>

    <div class="flex flex-col gap-8 lg:flex-row lg:items-start">
      <div class="w-full lg:max-w-md">
        {project.image ? (
          <img
            src={project.image.src}
            alt={project.image.alt}
            class="w-full rounded-xl border border-[var(--color-border)] object-contain"
            loading="eager"
            width="560"
            height="420"
          />
        ) : (
          <div
            class="flex aspect-[4/3] w-full items-center justify-center rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-soft)]"
            aria-label={p.title}
          >
            <span class="text-sm text-[var(--color-text-muted)]">{p.title}</span>
          </div>
        )}
      </div>

      <div class="flex-1">
        <span class="inline-block text-xs font-semibold uppercase tracking-wider text-cyan-400">
          {p.status}
        </span>
        <h1 class="mt-3 font-sans text-3xl font-bold tracking-tight text-[var(--color-text)] sm:text-4xl">
          {p.title}
        </h1>
        <p class="mt-4 max-w-2xl text-lg text-[var(--color-text-dim)]">{detail.lead}</p>
      </div>
    </div>
  </header>

  <div class="prose-faktum mx-auto mt-12 max-w-3xl">
    <ProjectSection title={isEn ? 'What it is' : 'Mikä se on?'}>
      <div set:html={whatItIsHtml}></div>
    </ProjectSection>

    {detail.pricing && (
      <ProjectSection title={detail.pricing.title}>
        <p class="font-sans text-3xl font-bold tracking-tight text-[var(--color-text)] sm:text-4xl">
          {detail.pricing.price}
        </p>
        <p class="mt-2 font-semibold text-[var(--color-text)]">{detail.pricing.license}</p>
        <p class="mt-4 text-[var(--color-text-dim)]">{detail.pricing.body}</p>
      </ProjectSection>
    )}

    {detail.pricingIncludes && (
      <ProjectSection title={detail.pricingIncludes.title}>
        <ul>
          {detail.pricingIncludes.bullets.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <p class="mt-4 text-sm italic text-[var(--color-text-dim)]">{detail.pricingIncludes.callout}</p>
      </ProjectSection>
    )}

    <ProjectSection title={isEn ? 'Problem solved' : 'Mitä ongelmaa ratkaistaan?'}>
      <div set:html={problemHtml}></div>
    </ProjectSection>

    <ProjectSection title={isEn ? 'How it works' : 'Miten ratkaisu toimii?'}>
      <div set:html={solutionHtml}></div>
    </ProjectSection>

    {detail.privacy && (
      <ProjectSection title={detail.privacy.heading}>
        {detail.privacy.intro && (
          <div class="mt-4 space-y-4 text-[var(--color-text-dim)]">
            {detail.privacy.intro.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        )}
        <h3 class="mt-8 font-sans text-xl font-bold tracking-tight text-[var(--color-text)] sm:text-2xl">
          {detail.privacy.deletionHeading}
        </h3>
        <div class="mt-4 space-y-4 text-[var(--color-text-dim)]">
          {detail.privacy.deletionBody.map((para) => (
            <p>{para}</p>
          ))}
        </div>
        <h3 class="mt-8 font-sans text-xl font-bold tracking-tight text-[var(--color-text)] sm:text-2xl">
          {detail.privacy.nonTraditionalHeading}
        </h3>
        <div class="mt-4 space-y-4 text-[var(--color-text-dim)]">
          {detail.privacy.nonTraditionalBody.map((para) => (
            <p>{para}</p>
          ))}
        </div>
      </ProjectSection>
    )}

    <ProjectSection title={isEn ? 'Who is it for?' : 'Kenelle?'}>
      <ul>
        {detail.audience.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </ProjectSection>

    {detail.hardware && (
      <ProjectSection title={isEn ? 'Hardware' : 'Laitteisto'}>
        <div set:html={toHtml(detail.hardware.body)}></div>
      </ProjectSection>
    )}

    <ProjectSection title={isEn ? 'Technical approach' : 'Tekninen toteutus'}>
      <div set:html={technicalHtml}></div>
    </ProjectSection>

    {detail.licenseSection && (
      <ProjectSection title={detail.licenseSection.heading}>
        {detail.licenseSection.body.map((para) => (
          <p>{para}</p>
        ))}
      </ProjectSection>
    )}

    {detail.updates && (
      <ProjectSection title={detail.updates.heading}>
        {detail.updates.body.map((para) => (
          <p>{para}</p>
        ))}
      </ProjectSection>
    )}

    {detail.support && (
      <ProjectSection title={detail.support.heading}>
        {detail.support.body.map((para) => (
          <p>{para}</p>
        ))}
      </ProjectSection>
    )}

    {detail.productionReference && (
      <ProductionReference
        reference={detail.productionReference}
        locale={locale}
      />
    )}

    <ProjectSection title={isEn ? 'Current state' : 'Nykytila'}>
      <div set:html={currentStateHtml}></div>
    </ProjectSection>

    <ProjectSection title={isEn ? 'Next step' : 'Seuraava vaihe'}>
      <div set:html={nextStepHtml}></div>
    </ProjectSection>

    {detail.organisationDeployment && (
      <>
        <section class="mb-12 scroll-mt-20">
          <h2 class="font-sans text-2xl font-bold tracking-tight text-[var(--color-text)] sm:text-3xl">
            {detail.organisationDeployment.heading}
          </h2>
          <div class="mt-6 text-[var(--color-text-dim)]">
            <div set:html={orgBodyHtml}></div>
            <ul>
              {detail.organisationDeployment.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {detail.organisationDeployment.callout && (
              <div class="mt-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-4">
                <h3 class="font-sans text-lg font-semibold text-[var(--color-text)]">{detail.organisationDeployment.callout.heading}</h3>
                <p class="mt-2 text-sm text-[var(--color-text-dim)]">{detail.organisationDeployment.callout.body}</p>
              </div>
            )}
          </div>
        </section>
        <CTASection cta={detail.organisationDeployment.cta} locale={locale} />
      </>
    )}

    {detail.cloudOption && (
      <ProjectSection title={detail.cloudOption.heading}>
        {detail.cloudOption.body.map((para) => (
          <p>{para}</p>
        ))}
      </ProjectSection>
    )}

    {detail.vision && (
      <ProjectSection title={detail.vision.heading}>
        {detail.vision.body.map((para) => (
          <p>{para}</p>
        ))}
      </ProjectSection>
    )}

    {detail.commercialization && (
      <ProjectSection title={detail.commercialization.heading}>
        <p>{detail.commercialization.body}</p>
        <ul>
          {detail.commercialization.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </ProjectSection>
    )}

    {detail.data && detail.data.length > 0 && (
      <ProjectSection title={isEn ? 'Data' : 'DATA'}>
        <p>{detail.dataPrinciple}</p>
        <ul>
          {detail.data.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </ProjectSection>
    )}

    {detail.aiRole && (
      <ProjectSection title={isEn ? 'The role of AI' : 'AI:n rooli'}>
        <div set:html={aiRoleHtml}></div>
      </ProjectSection>
    )}

    {detail.callout && (
      <Callout callout={detail.callout} locale={locale} />
    )}

    {detail.disclaimer && (
      <Disclaimer text={detail.disclaimer} locale={locale} />
    )}

    {detail.cta && (
      <CTASection cta={detail.cta} locale={locale} />
    )}

    <p class="mt-8 text-sm">
      ← <a href={projectsHref} class="text-cyan-400 hover:text-cyan-300">
        {isEn ? 'All projects' : 'Kaikki projektit'}
      </a>
    </p>
  </div>
</article>
