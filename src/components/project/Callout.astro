---
import type { ProjectDetail } from '../../data/projects';

interface Props {
  callout: NonNullable<ProjectDetail['callout']>;
  locale: 'fi' | 'en';
}

const { callout, locale } = Astro.props;
const isEn = locale === 'en';
---

<section class="mb-12">
  <div class="rounded-xl border border-cyan-500/30 bg-[var(--color-bg-elevated)] p-6 sm:p-8">
    <h2 class="font-sans text-xl font-bold tracking-tight text-cyan-300">
      {callout.heading}
    </h2>
    <div class="mt-4 space-y-4 text-[var(--color-text-dim)]">
      {callout.body.map((para) => (
        <p>{para}</p>
      ))}
    </div>
    {callout.cta && callout.cta.href && (
      <div class="mt-6">
        <a
          href={callout.cta.href}
          class="inline-block rounded-lg bg-cyan-500 px-5 py-2.5 text-sm font-semibold text-[var(--color-bg)] transition hover:bg-cyan-400"
        >
          {callout.cta.label}
        </a>
      </div>
    )}
    {callout.contactText && (
      <p class="mt-3 text-sm text-[var(--color-text-dim)]">
        {callout.contactText}
      </p>
    )}
  </div>
</section>
