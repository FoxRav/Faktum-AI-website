---
import type { Locale } from '../../i18n/config';
import type { Project } from '../../data/projects';
import { projectPath, projectLocale } from '../../data/projects';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const url = projectPath(locale, project.slug);
const p = projectLocale(project, locale);
const image = project.image;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] transition-colors hover:border-cyan-500/30 hover:bg-[var(--color-bg-soft)]"
>
  <a href={url} class="block" data-project={project.slug}>
    <figure class="relative aspect-square w-full overflow-hidden sm:aspect-[4/3]">
      {image ? (
        <img
          src={image.src}
          alt={image.alt}
          class:list={[
            'h-full w-full object-center transition group-hover:scale-[1.02]',
            image.fit === 'cover' ? 'object-cover' : 'object-contain',
          ]}
          loading="lazy"
          width="560"
          height="420"
        />
      ) : (
        <div
          class="absolute inset-0 flex flex-col items-center justify-center gap-3"
          aria-hidden="true"
        >
          <span
            class="block h-10 w-10 rounded-full border border-[var(--color-border)] bg-cyan-500/10"
          />
          <span class="block h-5 w-16 rounded-md bg-[var(--color-text-muted)]/25" />
        </div>
      )}
    </figure>
    <div class="flex flex-1 flex-col p-5">
      <h3 class="font-sans text-lg font-bold tracking-tight text-[var(--color-text)] group-hover:text-cyan-300">
        {p.title}
      </h3>
      <p class="mt-2 flex-1 text-sm text-[var(--color-text-dim)] line-clamp-3">
        {p.description}
      </p>
      <span class="mt-3 text-xs font-semibold uppercase tracking-wider text-cyan-400/80">
        {p.status}
      </span>
    </div>
  </a>
</article>
