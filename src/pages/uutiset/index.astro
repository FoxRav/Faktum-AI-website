---
import ListingLayout from '../../layouts/ListingLayout.astro';
import ArticleFeed from '../../components/sections/ArticleFeed.astro';
import { getAllArticles, getNewsArticles } from '../../utils/content';
import { t } from '../../i18n/ui';

const locale = 'fi' as const;
const filter = new URL(Astro.request.url).searchParams.get('filter');
const showNewsOnly = filter === 'uutiset';
const articles = showNewsOnly ? await getNewsArticles(locale) : await getAllArticles(locale);
---

<ListingLayout
  title="Uutiset"
  description={t(locale, 'listingNews')}
  path="/uutiset/"
  activeTab={showNewsOnly ? '/uutiset/?filter=uutiset' : '/uutiset/'}
  locale="fi"
>
  <ArticleFeed articles={articles} title="" emptyMessage="Ei julkaistuja artikkeleita vielä." />
</ListingLayout>
