---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Data request status" description="Data request status." path="/en/privacy/your-data/done/" robots="noindex, follow">
  <section class="container-site py-16 text-center">
    <h1 class="font-sans text-3xl font-bold">Data request status</h1>
    <p id="request-result" class="mt-4 text-[var(--color-text-dim)]"
      data-error="The request could not be verified. The link may be invalid or expired." data-deleted="Your data has been deleted." data-processed="The request has been processed.">Open the verification link sent to your email.</p>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var message = document.getElementById('request-result');
    if (!message) return;
    if (params.has('error')) {
      message.textContent = message.getAttribute('data-error');
      message.classList.add('text-red-400');
    } else if (params.get('result') === 'deleted') {
      message.textContent = message.getAttribute('data-deleted');
    } else if (params.get('result') === 'export_sent') {
      message.textContent = message.getAttribute('data-processed');
    }
  })();
</script>
