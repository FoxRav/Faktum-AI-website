---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryPath } from '../../i18n/paths';
import { t } from '../../i18n/ui';
import { organizationJsonLd, websiteJsonLd } from '../../utils/seo';

const locale = 'en' as const;
const projectsHref = categoryPath(locale, 'projects');
---

<BaseLayout
  title="About FaktumAI | FaktumAI"
  description={t(locale, 'aboutMetaDescription')}
  path="/en/about/"
  jsonLd={[organizationJsonLd('en'), websiteJsonLd('en')]}
>
  <section class="container-site py-12 lg:py-16">
    <h1 class="font-sans text-3xl font-bold tracking-tight text-[var(--color-text)] sm:text-4xl">
      What is FaktumAI?
    </h1>
    <div class="prose-faktum mt-8 max-w-3xl">
      <p>
        FaktumAI is a modern software company and project-management specialist. We develop our own software products, automation solutions and commercially oriented digital services using a lean, AI-assisted production model. Our expertise, however, is not limited to software or artificial intelligence.
      </p>

      <p>
        Our background combines mechanical and production engineering, industrial design, and project management for construction and renovation projects. We bring technical design, project leadership and agent-assisted software development into the same operating model.
      </p>

      <h2>Software and digital products</h2>
      <p>
        We develop our own software products and digital services around practical needs. The goal is to build working solutions, test them in real use and move the strongest projects toward productisation and commercial deployment.
      </p>

      <h2>Project management and technical expertise</h2>
      <p>
        In addition to software development, FaktumAI's expertise includes mechanical and production engineering, technical design, and project management for construction and renovation projects. This background influences how projects are defined, structured and managed.
      </p>

      <h2>AI-assisted operating model</h2>
      <p>
        At FaktumAI, AI is a development tool. We use language models and software agents to support design, coding, testing, documentation and analysis. Technical responsibility, architectural decisions and final quality assurance remain with people.
      </p>

      <h2>Projects and productisation</h2>
      <p>
        Some projects are in research and development, some are in testing and others are already in production use. The project pages describe the current status, technical direction and next development stages of each solution.
      </p>

      <h2>AI news and other publications</h2>
      <p>
        FaktumAI.com is first and foremost the company and product website of FaktumAI. The site also publishes selected AI news, interviews and articles about tools. Longer analyses are included in the news stream.
      </p>

      <h2>Contact</h2>
      <dl class="mt-4 space-y-3 text-[var(--color-text-dim)]">
        <div>
          <dt class="font-sans text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
            For software projects, collaboration or questions about FaktumAI products, contact
          </dt>
          <dd class="mt-1">
            <a href="mailto:marko@Faktum-AI.com">marko@Faktum-AI.com</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
