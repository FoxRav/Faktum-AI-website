---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectShowcase from '../../components/sections/ProjectShowcase.astro';
import { organizationJsonLd, websiteJsonLd } from '../../utils/seo';

const locale = 'en' as const;
---

<BaseLayout
  title="Projects · FaktumAI"
  description="FaktumAI software products and development projects — prototypes, pilots, and productisation."
  path="/en/projects/"
  ogImage="/images/brand/landing-hero.webp"
  jsonLd={[organizationJsonLd('en'), websiteJsonLd('en')]}
>
  <ProjectShowcase locale={locale} showAllLink={false} headingLevel={1} />
</BaseLayout>
