---
import ListingLayout from '../../../layouts/ListingLayout.astro';
import ArticleFeed from '../../../components/sections/ArticleFeed.astro';
import { getAllArticles } from '../../../utils/content';
import { t } from '../../../i18n/ui';

const locale = 'en' as const;
const articles = await getAllArticles(locale);
---

<ListingLayout
  title={t(locale, 'navNews')}
  description={t(locale, 'listingNews')}
  path="/en/news/"
  activeTab="/en/news/"
  locale={locale}
  filterable
  activeFilter="all"
>
  <ArticleFeed articles={articles} title="" emptyMessage={t(locale, 'emptyArticles')} />
</ListingLayout>
