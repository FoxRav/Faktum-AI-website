---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHero from '../components/sections/LandingHero.astro';
import MvpSection from '../components/sections/MvpSection.astro';
import OperatingModel from '../components/sections/OperatingModel.astro';
import ProjectShowcase from '../components/sections/ProjectShowcase.astro';
import { organizationJsonLd, websiteJsonLd } from '../utils/seo';
import { t } from '../i18n/ui';

const locale = 'fi' as const;
---

<BaseLayout
  title={t(locale, 'homeMetaTitle')}
  description={t(locale, 'homeMetaDescription')}
  path="/"
  ogImage="/images/brand/landing-hero.webp"
  jsonLd={[organizationJsonLd('fi'), websiteJsonLd('fi')]}
>
  <LandingHero locale={locale} />
  <MvpSection locale={locale} />
  <OperatingModel locale={locale} />
  <ProjectShowcase locale={locale} showAllLink={true} />
</BaseLayout>
