---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectShowcase from '../components/sections/ProjectShowcase.astro';
import { organizationJsonLd, websiteJsonLd } from '../utils/seo';

const locale = 'fi' as const;
---

<BaseLayout
  title="Projektit · FaktumAI"
  description="FaktumAI:n ohjelmistotuotteet ja kehitysprojektit – prototyypit, pilotit ja tuotteistus."
  path="/projektit/"
  ogImage="/images/brand/faktumai-og-2026-08.webp"
  ogImageWidth={1200}
  ogImageHeight={630}
  jsonLd={[organizationJsonLd('fi'), websiteJsonLd('fi')]}
>
  <ProjectShowcase locale={locale} showAllLink={false} headingLevel={1} />
</BaseLayout>
