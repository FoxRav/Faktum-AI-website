---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryPath } from '../i18n/paths';
import { t } from '../i18n/ui';
import { organizationJsonLd, websiteJsonLd } from '../utils/seo';

const locale = 'fi' as const;
const projectsHref = categoryPath(locale, 'projects');
---

<BaseLayout
  title="Tietoa FaktumAI:sta | FaktumAI"
  description={t(locale, 'aboutMetaDescription')}
  path="/tietoa/"
  jsonLd={[organizationJsonLd('fi'), websiteJsonLd('fi')]}
>
  <section class="container-site py-12 lg:py-16">
    <h1 class="font-sans text-3xl font-bold tracking-tight text-[var(--color-text)] sm:text-4xl">
      Mikä FaktumAI on?
    </h1>
    <div class="prose-faktum mt-8 max-w-3xl">
      <p>
        FaktumAI on uuden ajan ohjelmistotalo ja projektinhallinnan asiantuntija. Kehitämme omia ohjelmistotuotteita, automaatioratkaisuja ja kaupallistamiseen tähtääviä digitaalisia palveluja AI-avusteisella, kevyellä tuotantomallilla. Osaamisemme ei kuitenkaan rajoitu ohjelmistoihin tai tekoälyyn.
      </p>

      <p>
        Taustamme yhdistää kone- ja tuotantotekniikan, teollisen suunnittelun sekä rakennus- ja saneeraushankkeiden projektinhallinnan. Yhdistämme teknisen suunnittelun, projektijohtamisen ja agenttiavusteisen ohjelmistokehityksen samaan toimintamalliin.
      </p>

      <h2>Ohjelmistot ja digitaaliset tuotteet</h2>
      <p>
        Kehitämme omia ohjelmistotuotteita ja digitaalisia palveluja käytännön tarpeisiin. Tavoitteena on rakentaa toimivia ratkaisuja, testata niitä todellisessa käytössä ja viedä parhaat projektit kohti tuotteistamista ja kaupallista käyttöä.
      </p>

      <h2>Projektinhallinta ja tekninen osaaminen</h2>
      <p>
        FaktumAI:n osaamispohjaan kuuluu ohjelmistokehityksen lisäksi kone- ja tuotantotekniikkaa, teknistä suunnittelua sekä rakennus- ja saneeraushankkeiden projektinhallintaa. Tämä tausta vaikuttaa siihen, miten projekteja määritellään, vaiheistetaan ja johdetaan.
      </p>

      <h2>AI-avusteinen toimintamalli</h2>
      <p>
        AI toimii FaktumAI:ssa kehitystyön välineenä. Hyödynnämme kielimalleja ja ohjelmistoagentteja suunnittelussa, koodauksessa, testauksessa, dokumentoinnissa ja analyysissä. Tekninen vastuu, arkkitehtuuripäätökset ja lopullinen laadunvarmistus eivät kuitenkaan siirry tekoälylle.
      </p>

      <h2>Projektit ja tuotteistaminen</h2>
      <p>
        Osa projekteista on tutkimus- ja tuotekehitysvaiheessa, osa testauksessa ja osa jo tuotantokäytössä. Projektisivuilla kerrotaan avoimesti kunkin ratkaisun nykytila, tekninen suunta ja seuraavat kehitysvaiheet.
      </p>

      <h2>AI-uutiset ja muut julkaisut</h2>
      <p>
        FaktumAI.com toimii ensisijaisesti FaktumAI:n yritys- ja tuotesivustona. Sivustolla julkaistaan lisäksi valikoituja AI-uutisia, haastatteluja ja työkaluihin liittyviä kirjoituksia. Laajemmat analyysit ovat osa uutisvirtaa.
      </p>

      <h2>Yhteystiedot</h2>
      <dl class="mt-4 space-y-3 text-[var(--color-text-dim)]">
        <div>
          <dt class="font-sans text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
            Ohjelmistoprojekteihin, yhteistyöhön ja FaktumAI:n tuotteisiin liittyvissä asioissa ota yhteyttä
          </dt>
          <dd class="mt-1">
            <a href="mailto:marko@Faktum-AI.com">marko@Faktum-AI.com</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>
</BaseLayout>
