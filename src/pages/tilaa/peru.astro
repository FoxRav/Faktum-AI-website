---
import UnsubscribeForm from '../../components/forms/UnsubscribeForm.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { subscribePath } from '../../i18n/paths';

const locale = 'fi' as const;
---

<BaseLayout
  title="Uutiskirje lopetettu"
  description="FaktumAI ei tarjoa uutiskirjettä. Uutiset ja muu toimituksellinen sisältö ovat luettavissa Uutiset-osiossa."
  path={subscribePath(locale, 'unsubscribe')}
  robots="noindex, follow"
>
  <section class="container-site py-12 lg:py-16">
    <div class="mx-auto max-w-2xl">
      <h1 class="font-sans text-3xl font-bold sm:text-4xl">Uutiskirje lopetettu</h1>
      <p class="mt-4 text-[var(--color-text-dim)]">
        FaktumAI ei tarjoa uutiskirjettä. Uutiset, analyysit, haastattelut ja työkaluarviot ovat edelleen luettavissa Uutiset-osiossa.
      </p>
      <p class="mt-6">
        <a href="/uutiset/" class="text-cyan-400 hover:text-cyan-300 font-semibold">Siirry Uutiset-osioon</a>
      </p>
    </div>
  </section>
  <UnsubscribeForm locale={locale} />
</BaseLayout>
