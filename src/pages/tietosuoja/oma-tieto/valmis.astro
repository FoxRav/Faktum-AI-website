---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Tietopyynnön tila" description="Tietopyynnön tila." path="/tietosuoja/oma-tieto/valmis/" robots="noindex, follow">
  <section class="container-site py-16 text-center">
    <h1 class="font-sans text-3xl font-bold">Tietopyynnön tila</h1>
    <p id="request-result" class="mt-4 text-[var(--color-text-dim)]"
      data-error="Pyyntöä ei voitu vahvistaa. Linkki voi olla virheellinen tai vanhentunut." data-deleted="Tietosi on poistettu rekisteristä." data-processed="Pyyntö on käsitelty.">Avaa sähköpostitse saamasi vahvistuslinkki.</p>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var message = document.getElementById('request-result');
    if (!message) return;
    if (params.has('error')) {
      message.textContent = message.getAttribute('data-error');
      message.classList.add('text-red-400');
    } else if (params.get('result') === 'deleted') {
      message.textContent = message.getAttribute('data-deleted');
    } else if (params.get('result') === 'export_sent') {
      message.textContent = message.getAttribute('data-processed');
    }
  })();
</script>
