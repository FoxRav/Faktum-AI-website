---
import BaseLayout from './BaseLayout.astro';
import LegalProse from '../components/legal/LegalProse.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  noIndex?: boolean;
}

const { title, description, path, noIndex = false } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  robots={noIndex ? 'noindex, follow' : 'index, follow'}
>
  <LegalProse title={title} description={description} path={path}>
    <slot />
  </LegalProse>
</BaseLayout>
